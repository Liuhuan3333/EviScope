{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eviscope/dataset_manifest.schema.json",
  "title": "EviScope review-time sample manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "records"],
  "properties": {
    "schema_version": {"const": "eviscope.dataset-manifest.v0.1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id", "sample_kind", "provenance", "review", "artifacts",
        "analysis_eligible"
      ],
      "properties": {
        "sample_id": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"},
        "sample_kind": {"enum": ["natural", "challenge", "synthetic_smoke"]},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["forge", "repository", "repository_url", "license_spdx", "pr_number", "base_sha", "head_sha", "retrieved_at"],
          "properties": {
            "forge": {"enum": ["github", "gitlab", "other"]},
            "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
            "repository_url": {"type": "string", "format": "uri"},
            "license_spdx": {"type": "string", "minLength": 1},
            "pr_number": {"type": "integer", "minimum": 1},
            "base_sha": {"$ref": "#/$defs/sha40"},
            "head_sha": {"$ref": "#/$defs/sha40"},
            "retrieved_at": {"type": "string", "format": "date-time"}
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comment_id", "comment_author_type", "comment_text", "review_timestamp", "path"],
          "properties": {
            "comment_id": {"type": "string", "minLength": 1},
            "comment_author_type": {"enum": ["human", "model"]},
            "generator_registry_id": {"type": ["string", "null"]},
            "comment_text": {"type": "string", "minLength": 1},
            "review_timestamp": {"type": "string", "format": "date-time"},
            "path": {"type": "string", "minLength": 1},
            "original_line": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "level", "kind", "source_locator", "sha256", "available_at"],
            "properties": {
              "artifact_id": {"type": "string", "minLength": 1},
              "level": {"enum": ["L0", "L1", "L2", "L3"]},
              "kind": {"enum": ["diff", "file_before", "file_after", "enclosing_symbol", "definition", "reference", "call_relation", "import", "test", "configuration", "pr_description", "issue", "repository_documentation", "history"]},
              "source_locator": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "available_at": {"type": "string", "format": "date-time"}
            }
          }
        },
        "analysis_eligible": {"type": "boolean"},
        "exclusion_reason": {"type": ["string", "null"]}
      }
    }
  }
}

